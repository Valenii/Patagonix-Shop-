# ==========================================================================
# PATAGONIX SHOP - Plantilla de variables de entorno
# --------------------------------------------------------------------------
# 1. Copiar este archivo a `.env`           -> cp .env.example .env
# 2. Rellenar con los valores reales de tus proyectos de Firebase / AWS.
# 3. `.env` esta en .gitignore: NUNCA debe commitearse.
# ==========================================================================

# --------------------------------------------------------------------------
# FIREBASE (cliente / navegador)
# Prefijo VITE_ => Vite las inyecta en el bundle del frontend.
# Estas claves son PUBLICAS por diseño: la seguridad real la aportan las
# Firestore Security Rules (ver firestore.rules), no el secreto de la API key.
# Se obtienen en: Firebase Console > Project settings > Your apps > SDK config
# --------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Email que sera promovido a rol `admin` en el primer registro (opcional).
# Util para bootstrap: el resto de los usuarios se crean como `customer`.
VITE_BOOTSTRAP_ADMIN_EMAIL=

# Base URL de las Serverless Functions. Vacio = mismo origen (recomendado).
VITE_API_BASE_URL=

# --------------------------------------------------------------------------
# AWS S3 (SOLO backend serverless - NO usar prefijo VITE_)
# Estas variables jamas llegan al navegador: solo se leen dentro de /api/*.
# En Vercel: Project Settings > Environment Variables (Production + Preview).
# IAM: usuario con politica minima (PutObject, DeleteObject, GetObject) sobre
# arn:aws:s3:::<bucket>/products/*
# --------------------------------------------------------------------------
AWS_REGION=sa-east-1
AWS_S3_BUCKET=patagonix-shop-products
S3_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CDN / dominio publico del bucket (opcional).
# Si se define, las URLs publicas se construyen con este host en lugar de
# https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_BASE_URL=

# --------------------------------------------------------------------------
# AUTORIZACION DE LAS SERVERLESS FUNCTIONS
# /api/s3/* verifica el Firebase ID token del llamador y exige rol `admin`.
# Por defecto reutiliza VITE_FIREBASE_PROJECT_ID; esta variable solo es
# necesaria si el backend apunta a otro proyecto de Firebase.
# --------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
